# Telegram Bot
TELEGRAM_TOKEN=123456:ABC...        # from @BotFather
STAFF_CHAT_ID=0                     # send /chatid inside your staff group to find it
COUNCIL_NAME=EstateKaki (Singapore Town Councils)

# LLM & Embeddings (configure Gemini OR Anthropic; works offline with deterministic fallback)
GEMINI_API_KEY=                     # Google AI Studio key (used for Semantic RAG, Vision & Router)
ANTHROPIC_API_KEY=                  # Optional Claude fallback

# Optional RAG Overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# MIN_RELEVANCE_SCORE=0.28
# USE_LOCAL_EMBEDDINGS=false

# Optional Trello Work-Order Dispatch (leave TRELLO_BOARD_ID blank to disable)
TRELLO_BOARD_ID=
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_TODO_LIST=To Do
TRELLO_URGENT_LIST=Urgent
TRELLO_IN_PROGRESS_LIST=In Progress
TRELLO_DONE_LIST=Done
TRELLO_DUE_CRITICAL_HOURS=1
TRELLO_DUE_HIGH_HOURS=4
TRELLO_DUE_MEDIUM_HOURS=24

# Optional Staff Dashboard Password (leave empty for no login)
DASHBOARD_PASSWORD=
